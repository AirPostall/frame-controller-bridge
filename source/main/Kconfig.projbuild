menu "Steam Frame controllers"

config FRAME_LEFT_ADDRESS
    string "Left controller Bluetooth address"
    default "00:00:00:00:00:00"
    help
        Leave this at zero for an unpaired controller.

config FRAME_RIGHT_ADDRESS
    string "Right controller Bluetooth address"
    default "00:00:00:00:00:00"
    help
        Leave this at zero for an unpaired controller.

config FRAME_LOG_INTERVAL_MS
    int "Minimum milliseconds between notification samples per controller"
    range 0 60000
    default 250
    help
        Each sample includes the running packet count and up to 64 bytes.
        Set to zero to print every packet that reaches the callback. At high
        report rates the serial console can become the bottleneck.

endmenu
